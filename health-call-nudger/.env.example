ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
TO_NUMBER=
TERRA_SIGNING_SECRET=

# Shared secret for /nudge, /test-call, /acknowledge and PATCH /config. These
# place real calls and change who gets called, so they are never open: without a
# token they accept loopback connections only. Required on any public host.
ADMIN_TOKEN=

# Escalation (only used when escalationEnabled is true in config.json).
# The emergency contact must have consented to being called automatically.
ELEVENLABS_ESCALATION_AGENT_ID=
EMERGENCY_CONTACT_NUMBER=
EMERGENCY_CONTACT_NAME=

# Deployment. BIND_ADDRESS defaults to 127.0.0.1; the container sets 0.0.0.0.
# TRUST_PROXY=1 only when something in front sets X-Forwarded-For.
BIND_ADDRESS=
TRUST_PROXY=
